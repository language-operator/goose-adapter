{
  "schemaVersion": 1,
  "name": "goose",
  "displayName": "goose",
  "role": "main",
  "requires": { "codingRuntime": ">=0.1.2 <1.0.0" },
  "env": {
    "GOOSE_PATH_ROOT": "${STATE_DIR}/goose",
    "GOOSE_TELEMETRY_ENABLED": "false"
  },
  "preflight": [{ "path": "${STATE_DIR}/goose", "mode": "700" }],
  "config": { "emitter": { "type": "module", "path": "/opt/adapter/emit.mjs" } },
  "serve": { "surface": "terminal", "port": 8080, "originGuard": true },
  "terminal": {
    "tmuxSession": "goose",
    "launch": ["launch-goose"],
    "cwd": "${WORKDIR}",
    "wsPath": "/ws",
    "keepaliveSeconds": 25
  }
}
